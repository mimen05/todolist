        <mxCell id="e1" value="one user has many tasks" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#0E6E62;fontSize=11;fontColor=#5C6373;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="f_tasks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="one task, many tag links" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#8A4B12;fontSize=11;fontColor=#5C6373;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f_tasks" target="task_tags">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="one tag, many task links" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#8A4B12;fontSize=11;fontColor=#5C6373;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="tags" target="task_tags">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="The splayed &quot;crow's foot&quot; end means MANY.&#10;The single bar means ONE.&#10;&#10;A foreign key (FK) always lives on the many side.&#10;&#10;tasks and tags are many-to-many: a task can have&#10;many tags AND a tag can apply to many tasks. There&#10;is nowhere to put a single FK for that, so task_tags&#10;exists purely to hold the pairs. That is a join table." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#5C6373;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="360" height="200" as="geometry" />
        </mxCell>
